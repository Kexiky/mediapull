# MediaPull Server Configuration
PORT=8000
HOST=127.0.0.1
MEDIAPULL_WEB_URL=http://127.0.0.1:8000

# Security
# Если ключ не указан, он будет сгенерирован автоматически и сохранен в data/.secret_key
MEDIAPULL_SECRET_KEY=

# Настройки параллельных загрузок
MAX_CONCURRENT_DOWNLOADS=3

# Разрешенные CORS Origin через запятую (по умолчанию разрешены localhost/127.0.0.1 и MEDIAPULL_WEB_URL)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Telegram Bot Token (получите у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=
# Закрытый режим бота: Telegram ID через запятую (пусто = бот открыт для всех)
TELEGRAM_ALLOWED_IDS=

# За reverse-proxy с HTTPS (nginx, Caddy, ...) включите:
# MEDIAPULL_TRUST_PROXY=true
# Разрешить ссылки на локальную сеть (по умолчанию запрещены — защита от SSRF):
# MEDIAPULL_ALLOW_PRIVATE_URLS=true

# --- Telegram-бот: расширенные настройки ---
# Админы бота (Telegram ID через запятую): /stats, /allow, /ban, /closed, /update
TELEGRAM_ADMIN_IDS=
# Имя бота без @ (для inline-режима и подсказок в личном кабинете сайта)
TELEGRAM_BOT_USERNAME=
# Тариф для пользователей, не привязавших веб-аккаунт: user | premium | guest
TELEGRAM_DEFAULT_ROLE=user
# Локальный Bot API сервер (лимит файлов 2 ГБ): docker compose --profile local-api up -d
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_SERVER=
# Webhook вместо long polling (нужен HTTPS-адрес, проксирующий на порт бота)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PORT=8080

# --- yt-dlp ---
# Автообновление yt-dlp раз в сутки (рекомендуется для долгоживущих серверов)
MEDIAPULL_YTDLP_AUTO_UPDATE=true
# Файл cookies (формат Netscape) для возрастных/приватных видео и прокси
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
