# MediaPull Server Configuration
PORT=8000
HOST=127.0.0.1
MEDIAPULL_WEB_URL=http://127.0.0.1:8000

# Security (Обязательно смените секретный ключ и пароль админа в продакшене!)
# Если ключ не указан, он будет сгенерирован автоматически и сохранен в data/.secret_key
MEDIAPULL_SECRET_KEY=
# Пароль для главного аккаунта создателя (kexiky)
KEXIKY_PASSWORD=

# Настройки параллельных загрузок
MAX_CONCURRENT_DOWNLOADS=3

# Разрешенные CORS Origin через запятую (по умолчанию разрешены localhost/127.0.0.1 и MEDIAPULL_WEB_URL)
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Telegram Bot Token (получите у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=
